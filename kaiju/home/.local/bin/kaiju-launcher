#!/usr/bin/env bash
# Kaiju launcher: a floating foot window running fzf over desktop entries.
# Hyprland gives it the ash to stone border and the magma glow (see
# hypr/kaiju.lua); foot requests the blur through ext-background-effect.
# Pressing the bind again while it is open closes it.
set -euo pipefail

if hyprctl clients -j | grep -q '"class": "kaiju-launcher"'; then
    hyprctl eval 'kaiju_close_launcher()' >/dev/null
    exit 0
fi

exec foot \
    --app-id=kaiju-launcher \
    --title=Launcher \
    -o main.pad=18x14 \
    -o main.font="Red Hat Mono:size=10.5" \
    -o main.line-height=22 \
    -o colors-dark.alpha=0.94 \
    -o colors-light.alpha=0.94 \
    "$HOME/.local/bin/kaiju-launcher-menu"
