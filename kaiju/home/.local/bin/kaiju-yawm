#!/usr/bin/env bash
# Taskwarrior popups for the waybar "yawm" module, same frames as the
# launcher (window rules kaiju-yawm / kaiju-yawm-add in hypr/kaiju.lua).
#   kaiju-yawm        task list  (click)
#   kaiju-yawm add    quick add  (right-click)
# Running it again while that popup is open closes it.
set -euo pipefail

mode=${1:-list}
if [[ $mode == add ]]; then
    class=kaiju-yawm-add title="Add task"
else
    class=kaiju-yawm title="Yawm"
fi

if hyprctl clients -j | grep -q "\"class\": \"$class\""; then
    hyprctl eval 'kaiju_close_popups()' >/dev/null
    exit 0
fi

exec foot \
    --app-id="$class" \
    --title="$title" \
    -o main.pad=18x14 \
    -o main.font="Red Hat Mono:size=10.5" \
    -o main.line-height=22 \
    -o colors-dark.alpha=0.94 \
    -o colors-light.alpha=0.94 \
    "$HOME/.local/bin/kaiju-yawm-menu" "$mode"
